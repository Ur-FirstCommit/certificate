# Copy these public values into public/config.js for the static browser app.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Set this as the ALLOWED_ORIGINS Edge Function secret (comma-separated exact origins).
ALLOWED_ORIGINS=https://certificates.example.org,http://localhost:4173

# SUPABASE_URL and Supabase publishable/secret keys are injected into Edge Functions.
# Never put a service-role key or Supabase secret key in public/config.js.
